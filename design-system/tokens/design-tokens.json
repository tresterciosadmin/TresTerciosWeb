      "5": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "64 px.",
        "$extensions": {
          "tresTercios.cssVar": "--s5"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "96 px. Padding de sección.",
        "$extensions": {
          "tresTercios.cssVar": "--s6"
        }
      }
