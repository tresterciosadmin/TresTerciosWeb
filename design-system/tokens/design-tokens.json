    "space": {
      "1": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "8 px. Unidad base.",
        "$extensions": {
          "tresTercios.cssVar": "--s1"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "16 px.",
        "$extensions": {
          "tresTercios.cssVar": "--s2"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "24 px. Padding de tarjeta.",
        "$extensions": {
          "tresTercios.cssVar": "--s3"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "40 px. Padding de tarjeta grande.",
        "$extensions": {
          "tresTercios.cssVar": "--s4"
        }
