{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tres Tercios — sistema de diseño v1.1. Fuente de verdad: el bloque :root de index.html.",
  "color": {
    "brand": {
      "bordo": {
        "$type": "color",
        "$value": "#7D1F30",
        "$description": "Color principal de marca. Acento único del clima claro.",
        "$extensions": {
          "tresTercios.cssVar": "--bordo"
        }
      },
      "bordoOscuro": {
        "$type": "color",
        "$value": "#5E1724",
        "$description": "Hover y presión.",
        "$extensions": {
          "tresTercios.cssVar": "--bordo-oscuro"
        }
      },
      "bordoClaro": {
        "$type": "color",
        "$value": "#C4526A",
        "$description": "Acento intermedio.",
        "$extensions": {
          "tresTercios.cssVar": "--bordo-claro"
        }
      },
      "bordoTinte": {
        "$type": "color",
        "$value": "#F4EAEB",
        "$description": "Halo del hero, anillo de foco, tarjeta insignia.",
        "$extensions": {
          "tresTercios.cssVar": "--bordo-tinte"
        }
      },
      "bordoBorde": {
        "$type": "color",
        "$value": "#E4CFD2",
        "$description": "Borde de superficies tintadas.",
        "$extensions": {
          "tresTercios.cssVar": "--bordo-borde"
        }
      }
    },
    "surface": {
      "papel": {
        "$type": "color",
        "$value": "#F7F3EC",
        "$description": "Fondo base del clima claro. No cambia entre secciones.",
        "$extensions": {
          "tresTercios.cssVar": "--bg"
        }
      },
      "arena": {
        "$type": "color",
        "$value": "#EFE9DF",
        "$description": "Reservado a la zona de cierre.",
        "$extensions": {
          "tresTercios.cssVar": "--bg-2"
        }
      },
      "elevada": {
        "$type": "color",
        "$value": "#FDFBF7",
        "$description": "Tarjetas y formularios.",
        "$extensions": {
          "tresTercios.cssVar": "--surface"
        }
      },
      "borde": {
        "$type": "color",
        "$value": "#E0D8CB",
        "$description": "Filetes y separadores.",
        "$extensions": {
          "tresTercios.cssVar": "--border"
        }
      },
      "bordeFuerte": {
        "$type": "color",
        "$value": "#CFC5B4",
        "$description": "Campos y controles.",
        "$extensions": {
          "tresTercios.cssVar": "--border-fuerte"
        }
      }
    },
    "text": {
      "tinta": {
        "$type": "color",
        "$value": "#191817",
        "$description": "Texto principal.",
        "$extensions": {
          "tresTercios.cssVar": "--text"
        }
      },
      "gris": {
        "$type": "color",
        "$value": "#5C564D",
        "$description": "Texto secundario.",
        "$extensions": {
          "tresTercios.cssVar": "--muted"
        }
      }
    },
    "dark": {
      "noche": {
        "$type": "color",
        "$value": "#0E1219",
        "$description": "Fondo del clima oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-bg"
        }
      },
      "panel": {
        "$type": "color",
        "$value": "#161C27",
        "$description": "Panel sobre oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-surface"
        }
      },
      "panelElevado": {
        "$type": "color",
        "$value": "#1E2634",
        "$description": "Segundo nivel de elevación.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-surface2"
        }
      },
      "borde": {
        "$type": "color",
        "$value": "rgba(255,255,255,.10)",
        "$description": "Borde sobre oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-border"
        }
      },
      "grilla": {
        "$type": "color",
        "$value": "rgba(255,255,255,.045)",
        "$description": "Grilla técnica de fondo.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-grid"
        }
      },
      "texto": {
        "$type": "color",
        "$value": "#EDF1F7",
        "$description": "Texto principal sobre oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-text"
        }
      },
      "textoSecundario": {
        "$type": "color",
        "$value": "#94A1B5",
        "$description": "Texto de apoyo sobre oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-muted"
        }
      },
      "acento": {
        "$type": "color",
        "$value": "#D4677F",
        "$description": "Único acento válido sobre fondo oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-acento"
        }
      },
      "acentoHover": {
        "$type": "color",
        "$value": "#E07A91",
        "$description": "Hover del acento oscuro.",
        "$extensions": {
          "tresTercios.cssVar": "--dk-acento-hover"
        }
      },
      "sobreAcento": {
        "$type": "color",
        "$value": "#170A0E",
        "$description": "Texto sobre el acento iluminado.",
        "$extensions": {
          "tresTercios.cssVar": "--sobre-acento"
        }
      }
    },
    "feedback": {
      "okFondo": {
        "$type": "color",
        "$value": "#E9F1DC",
        "$description": "Fondo del mensaje de éxito.",
        "$extensions": {
          "tresTercios.cssVar": "--ok-bg"
        }
      },
      "okBorde": {
        "$type": "color",
        "$value": "#B3D189",
        "$description": "Borde del mensaje de éxito.",
        "$extensions": {
          "tresTercios.cssVar": "--ok-borde"
        }
      },
      "okTexto": {
        "$type": "color",
        "$value": "#2C4E10",
        "$description": "Texto del mensaje de éxito.",
        "$extensions": {
          "tresTercios.cssVar": "--ok-text"
        }
      },
      "errorFondo": {
        "$type": "color",
        "$value": "#F8E3E3",
        "$description": "Fondo del mensaje de error.",
        "$extensions": {
          "tresTercios.cssVar": "--err-bg"
        }
      },
      "errorBorde": {
        "$type": "color",
        "$value": "#E2A0A0",
        "$description": "Borde del mensaje de error.",
        "$extensions": {
          "tresTercios.cssVar": "--err-borde"
        }
      },
      "errorTexto": {
        "$type": "color",
        "$value": "#751919",
        "$description": "Texto del mensaje de error.",
        "$extensions": {
          "tresTercios.cssVar": "--err-text"
        }
      },
      "live": {
        "$type": "color",
        "$value": "#6FD08C",
        "$description": "Indicador de dato en actualización continua.",
        "$extensions": {
          "tresTercios.cssVar": "--live"
        }
      }
