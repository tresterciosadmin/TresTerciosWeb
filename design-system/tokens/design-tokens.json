  "shadow": {
    "default": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(25,24,23,.04),0 10px 30px rgba(25,24,23,.07)",
      "$description": "Sombra única del sistema.",
      "$extensions": {
        "tresTercios.cssVar": "--shadow"
      }
    }
  },
  "motion": {
    "easing": {
      "default": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(.2,.7,.3,1)",
        "$description": "Curva única.",
        "$extensions": {
          "tresTercios.cssVar": "--ease"
        }
      }
    },
    "duration": {
      "default": {
        "$type": "duration",
        "$value": "220ms",
        "$description": "220 ms.",
        "$extensions": {
          "tresTercios.cssVar": "--t"
        }
      }
    }
  }
}