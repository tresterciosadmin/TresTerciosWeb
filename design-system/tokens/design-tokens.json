      "xs": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "13 px. Etiqueta de formulario.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-xs"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "14.5px",
        "$description": "14,5 px. Texto de tarjeta y de lista.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-sm"
        }
      },
      "ui": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "15 px. Botones y enlaces.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-ui"
        }
      },
      "base": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "16 px. Cuerpo.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-base"
        }
      },
      "lead": {
        "$type": "dimension",
        "$value": "16.5px",
        "$description": "16,5 px. Bajada de sección.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-lead"
        }
      },
      "leadLg": {
        "$type": "dimension",
        "$value": "17.5px",
        "$description": "17,5 px. Bajada del hero.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-lead-lg"
