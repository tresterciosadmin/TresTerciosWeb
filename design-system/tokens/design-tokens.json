      "default": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Tarjetas y paneles.",
        "$extensions": {
          "tresTercios.cssVar": "--radius"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "Campos y cifras.",
        "$extensions": {
          "tresTercios.cssVar": "--radius-sm"
        }
      }
    },
    "layout": {
      "contenido": {
        "$type": "dimension",
        "$value": "1080px",
        "$description": "Ancho máximo del contenido.",
        "$extensions": {
          "tresTercios.cssVar": "--maxw"
        }
      },
      "nav": {
        "$type": "dimension",
        "$value": "780px",
        "$description": "Ancho de la navegación, menor a propósito.",
        "$extensions": {
          "tresTercios.cssVar": "--navw"
        }
