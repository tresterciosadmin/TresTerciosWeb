        "$type": "dimension",
        "$value": "11px",
        "$description": "11 px. Etiqueta de panel y eje de la franja.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-tabla"
        }
      },
      "cita": {
        "$type": "dimension",
        "$value": "17px",
        "$description": "17 px. La línea propia de un perfil.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-cita"
        }
      },
      "medidor": {
        "$type": "dimension",
        "$value": "30px",
        "$description": "30 px. La cifra del medidor.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-medidor"
        }
      },
      "nota": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "10 px. Nota al pie del medidor.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-nota"
