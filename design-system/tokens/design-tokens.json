  "typography": {
    "family": {
      "serif": {
        "$type": "fontFamily",
        "$value": "'Source Serif 4',Georgia,serif",
        "$description": "Títulos de sección. Source Serif 4.",
        "$extensions": {
          "tresTercios.cssVar": "--serif"
        }
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "'Inter',-apple-system,'Segoe UI',sans-serif",
        "$description": "Texto, interfaz y display. Inter.",
        "$extensions": {
          "tresTercios.cssVar": "--sans"
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'IBM Plex Mono',ui-monospace,monospace",
        "$description": "Cifras, antetítulos y etiquetas. IBM Plex Mono.",
        "$extensions": {
          "tresTercios.cssVar": "--mono"
        }
      }
    },
    "size": {
      "nano": {
        "$type": "dimension",
        "$value": "10.5px",
        "$description": "10,5 px. Etiquetas mono, tag, nota.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-nano"
        }
      },
      "micro": {
        "$type": "dimension",
        "$value": "11.5px",
        "$description": "11,5 px. Antetítulo y pastillas del recorrido.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-micro"
        }
      },
      "mini": {
        "$type": "dimension",
        "$value": "12.5px",
        "$description": "12,5 px. Etiqueta de cifra, pie del medidor.",
