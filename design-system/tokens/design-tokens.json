        }
      },
      "after": {
        "$type": "dimension",
        "$value": "15.5px",
        "$description": "15,5 px. Párrafo de cierre de bloque.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-after"
        }
      },
      "h2Sm": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "24 px. Título de modal y de bloque menor.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-h2-sm"
        }
      },
      "insignia": {
        "$type": "dimension",
        "$value": "25px",
        "$description": "25 px. Título de la tarjeta insignia.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-insignia"
        }
      },
      "nombre": {
        "$type": "dimension",
        "$value": "27px",
        "$description": "27 px. Nombre de perfil.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-nombre"
        }
      },
      "h2": {
        "$type": "dimension",
        "$value": "clamp(27px,3.4vw,38px)",
        "$description": "Título de sección, fluido.",
        "$extensions": {
          "tresTercios.cssVar": "--fs-h2"
